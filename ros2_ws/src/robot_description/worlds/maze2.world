<?xml version="1.0" ?>
<sdf version="1.6">

  <world name="maze2_world">


    <!-- ================= PHYSICS ================= -->

    <!-- Same tightened ODE solver settings as maze.world -- see that
         file for the reasoning. Kept identical here so a difference in
         behaviour between the two mazes is attributable to the wall
         layout, not to the physics. -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>


    <!-- ================= ROS STATE PLUGIN ================= -->

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>1.0</update_rate>
    </plugin>


    <!-- ================= DEFAULT VIEW ================= -->

    <gui>
      <camera name="user_camera">
        <pose>2.5 2.5 8.0 0 1.5708 0</pose>
      </camera>
    </gui>


    <!-- ================= LIGHT ================= -->

    <include>
      <uri>model://sun</uri>
    </include>


    <!-- ================================================================
         COORDINATE SYSTEM NOTE

         Same 5x5 grid convention as maze.world: cell (col, row) with
         col,row in 0..4 maps to world coordinates (x = col + 0.5,
         y = row + 0.5). No negative coordinates anywhere.

         THIS IS A SECOND, INDEPENDENT LAYOUT
         -------------------------------------
         maze2.world exists only to prove the RL pipeline generalizes to
         a maze it was never trained on when retrained from scratch --
         it is not a replacement for maze.world and is not the single
         source of truth for anything. Point RL_MAZE_WORLD and
         RL_Q_TABLE at this file's layout and a separate table path
         before training or running against it; do not overwrite the
         canonical q_table.pkl with a table trained on this layout.

         Blocked edges (14 total, 0 in common with maze.world):
           (0,2)-(1,2)  (0,4)-(1,4)  (1,1)-(1,2)  (1,1)-(2,1)
           (1,2)-(2,2)  (1,4)-(2,4)  (2,0)-(2,1)  (2,1)-(3,1)
           (2,3)-(3,3)  (3,1)-(3,2)  (3,2)-(3,3)  (3,3)-(3,4)
           (4,0)-(4,1)  (4,1)-(4,2)

         Fully connected (verified by BFS): every one of the 600
         start/goal pairs is solvable. Dead ends: (0,4) (1,2) (1,4)
         (2,1) (3,3) (4,0) (4,1). Worst-case shortest path is 15 steps,
         (3,3) -> (4,1).
         ================================================================ -->


    <!-- ================= FLOOR ================= -->

    <model name="ground">

      <static>true</static>

      <link name="ground_link">

        <collision name="ground_collision">
          <geometry>
            <box>
              <size>5.4 5.4 0.05</size>
            </box>
          </geometry>
        </collision>

        <visual name="ground_visual">
          <geometry>
            <box>
              <size>5.4 5.4 0.05</size>
            </box>
          </geometry>

          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>

        <pose>2.5 2.5 -0.025 0 0 0</pose>

      </link>

    </model>


    <!-- ================================================= -->
    <!-- OUTER WALLS                                       -->
    <!-- ================================================= -->


    <!-- TOP -->

    <model name="top_wall">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>5.1 0.10 0.50</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>5.1 0.10 0.50</size>
            </box>
          </geometry>
        </visual>

      </link>

      <pose>2.5 5.0 0.25 0 0 0</pose>

    </model>


    <!-- BOTTOM -->

    <model name="bottom_wall">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>5.1 0.10 0.50</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>5.1 0.10 0.50</size>
            </box>
          </geometry>
        </visual>

      </link>

      <pose>2.5 0.0 0.25 0 0 0</pose>

    </model>


    <!-- LEFT -->

    <model name="left_wall">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.10 5.1 0.50</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.10 5.1 0.50</size>
            </box>
          </geometry>
        </visual>

      </link>

      <pose>0.0 2.5 0.25 0 0 0</pose>

    </model>


    <!-- RIGHT -->

    <model name="right_wall">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.10 5.1 0.50</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.10 5.1 0.50</size>
            </box>
          </geometry>
        </visual>

      </link>

      <pose>5.0 2.5 0.25 0 0 0</pose>

    </model>



    <!-- ================================================= -->
    <!-- INNER WALL 1  -- blocks (0,2)-(1,2)                -->
    <!-- ================================================= -->

    <model name="wall_col1_r2">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.10 1.0 0.50</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.10 1.0 0.50</size>
            </box>
          </geometry>
        </visual>

      </link>

      <pose>1.0 2.5 0.25 0 0 0</pose>

    </model>



    <!-- ================================================= -->
    <!-- INNER WALL 2  -- blocks (0,4)-(1,4)                -->
    <!-- ================================================= -->

    <model name="wall_col1_r4">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.10 1.0 0.50</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.10 1.0 0.50</size>
            </box>
          </geometry>
        </visual>

      </link>

      <pose>1.0 4.5 0.25 0 0 0</pose>

    </model>



    <!-- ================================================= -->
    <!-- INNER WALL 3  -- blocks (1,1)-(1,2)                -->
    <!-- ================================================= -->

    <model name="wall_row2_c1">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.0 0.10 0.50</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.0 0.10 0.50</size>
            </box>
          </geometry>
        </visual>

      </link>

      <pose>1.5 2.0 0.25 0 0 0</pose>

    </model>



    <!-- ================================================= -->
    <!-- INNER WALL 4  -- blocks (1,1)-(2,1) and (1,2)-(2,2) -->
    <!-- ================================================= -->

    <model name="wall_col2_r1r2">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.10 2.0 0.50</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.10 2.0 0.50</size>
            </box>
          </geometry>
        </visual>

      </link>

      <pose>2.0 2.0 0.25 0 0 0</pose>

    </model>



    <!-- ================================================= -->
    <!-- INNER WALL 5  -- blocks (1,4)-(2,4)                -->
    <!-- ================================================= -->

    <model name="wall_col2_r4">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.10 1.0 0.50</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.10 1.0 0.50</size>
            </box>
          </geometry>
        </visual>

      </link>

      <pose>2.0 4.5 0.25 0 0 0</pose>

    </model>



    <!-- ================================================= -->
    <!-- INNER WALL 6  -- blocks (2,0)-(2,1)                -->
    <!-- ================================================= -->

    <model name="wall_row1_c2">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.0 0.10 0.50</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.0 0.10 0.50</size>
            </box>
          </geometry>
        </visual>

      </link>

      <pose>2.5 1.0 0.25 0 0 0</pose>

    </model>



    <!-- ================================================= -->
    <!-- INNER WALL 7  -- blocks (2,1)-(3,1)                -->
    <!-- ================================================= -->

    <model name="wall_col3_r1">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.10 1.0 0.50</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.10 1.0 0.50</size>
            </box>
          </geometry>
        </visual>

      </link>

      <pose>3.0 1.5 0.25 0 0 0</pose>

    </model>



    <!-- ================================================= -->
    <!-- INNER WALL 8  -- blocks (2,3)-(3,3)                -->
    <!-- ================================================= -->

    <model name="wall_col3_r3">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.10 1.0 0.50</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.10 1.0 0.50</size>
            </box>
          </geometry>
        </visual>

      </link>

      <pose>3.0 3.5 0.25 0 0 0</pose>

    </model>



    <!-- ================================================= -->
    <!-- INNER WALL 9  -- blocks (3,1)-(3,2) and (4,1)-(4,2) -->
    <!-- ================================================= -->

    <model name="wall_row2_c3c4">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>2.0 0.10 0.50</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>2.0 0.10 0.50</size>
            </box>
          </geometry>
        </visual>

      </link>

      <pose>4.0 2.0 0.25 0 0 0</pose>

    </model>



    <!-- ================================================= -->
    <!-- INNER WALL 10 -- blocks (3,2)-(3,3)                -->
    <!-- ================================================= -->

    <model name="wall_row3_c3">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.0 0.10 0.50</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.0 0.10 0.50</size>
            </box>
          </geometry>
        </visual>

      </link>

      <pose>3.5 3.0 0.25 0 0 0</pose>

    </model>



    <!-- ================================================= -->
    <!-- INNER WALL 11 -- blocks (3,3)-(3,4)                -->
    <!-- ================================================= -->

    <model name="wall_row4_c3">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.0 0.10 0.50</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.0 0.10 0.50</size>
            </box>
          </geometry>
        </visual>

      </link>

      <pose>3.5 4.0 0.25 0 0 0</pose>

    </model>



    <!-- ================================================= -->
    <!-- INNER WALL 12 -- blocks (4,0)-(4,1)                -->
    <!-- ================================================= -->

    <model name="wall_row1_c4">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.0 0.10 0.50</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.0 0.10 0.50</size>
            </box>
          </geometry>
        </visual>

      </link>

      <pose>4.5 1.0 0.25 0 0 0</pose>

    </model>


  </world>

</sdf>
