<?xml version="1.0" ?>

<sdf version="1.6">

  <world name="maze_world">
  

    <!-- ================= PHYSICS ================= -->

    <!-- Solver/constraint settings tightened beyond ODE defaults to
         reduce any residual contact jitter when the robot's box
         collision touches a wall -- more solver iterations and a
         thin contact surface layer make collision resolution more
         stable, which matters most for a small, light robot bumping
         thin (0.10m) walls at high wheel stiffness. -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>


    <!-- ================= DEFAULT VIEW ================= -->

    <!-- Opens gzclient looking straight down at the maze center, so
         the view is consistent every time regardless of how the
         camera was last left in a previous session. -->
    <gui>
      <camera name="user_camera">
        <pose>2.5 2.5 8.0 0 1.5708 0</pose>
      </camera>
    </gui>


    <!-- ================= LIGHT ================= -->

    <include>
      <uri>model://sun</uri>
    </include>


    <!-- ================================================================
         COORDINATE SYSTEM NOTE

         The maze sits fully in the first quadrant with NO negative
         coordinates anywhere, including wall extents.

         Grid cell (col, row) with col,row in 0..4 maps to world
         coordinates (x = col + 0.5, y = row + 0.5) -- i.e. cell CENTERS
         land on the half-integers {0.5, 1.5, 2.5, 3.5, 4.5}.

         The outer boundary walls sit exactly on the integer grid lines
         (x = 0, x = 5, y = 0, y = 5), which is the edge of cell 0 and
         the edge of cell 4 respectively. So every wall, not just every
         cell center, lies within [0, 5] x [0, 5] -- nothing overhangs
         into negative space.

         This layout is the single source of truth. The controller's
         HORIZONTAL_BLOCKS / VERTICAL_BLOCKS tables were derived
         directly from the wall poses below -- if you ever edit a wall
         here, the matching table in localized_maze_controller.py must
         be updated too, or the map-consistency check will start
         reporting false mismatches.
         ================================================================ -->


    <!-- ================= FLOOR ================= -->

    <model name="ground">

      <static>true</static>

      <link name="ground_link">

        <collision name="ground_collision">
          <geometry>
            <box>
              <size>5.4 5.4 0.05</size>
            </box>
          </geometry>
        </collision>

        <visual name="ground_visual">
          <geometry>
            <box>
              <size>5.4 5.4 0.05</size>
            </box>
          </geometry>

          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>

        <pose>2.5 2.5 -0.025 0 0 0</pose>

      </link>

    </model>


    <!-- ================================================= -->
    <!-- OUTER WALLS                                       -->
    <!-- ================================================= -->


    <!-- TOP -->

    <model name="top_wall">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>5.1 0.10 0.50</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>5.1 0.10 0.50</size>
            </box>
          </geometry>
        </visual>

      </link>

      <pose>2.5 5.0 0.25 0 0 0</pose>

    </model>


    <!-- BOTTOM -->

    <model name="bottom_wall">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>5.1 0.10 0.50</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>5.1 0.10 0.50</size>
            </box>
          </geometry>
        </visual>

      </link>

      <pose>2.5 0.0 0.25 0 0 0</pose>

    </model>


    <!-- LEFT -->

    <model name="left_wall">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.10 5.1 0.50</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.10 5.1 0.50</size>
            </box>
          </geometry>
        </visual>

      </link>

      <pose>0.0 2.5 0.25 0 0 0</pose>

    </model>


    <!-- RIGHT -->

    <model name="right_wall">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.10 5.1 0.50</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.10 5.1 0.50</size>
            </box>
          </geometry>
        </visual>

      </link>

      <pose>5.0 2.5 0.25 0 0 0</pose>

    </model>



    <!-- ================================================= -->
    <!-- INNER WALL 1                                      -->
    <!-- ================================================= -->

    <model name="wall_D1_D2">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.10 1.0 0.50</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.10 1.0 0.50</size>
            </box>
          </geometry>
        </visual>

      </link>

      <pose>3.0 4.5 0.25 0 0 0</pose>

    </model>



    <!-- ================================================= -->
    <!-- INNER WALL 2                                      -->
    <!-- ================================================= -->

    <model name="wall_E1_E2">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.10 1.0 0.50</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.10 1.0 0.50</size>
