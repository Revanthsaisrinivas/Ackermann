      <pose>1.0 1.0 0.25 0 0 0</pose>

    </model>



    <!-- ================================================= -->
    <!-- INNER WALL 9                                      -->
    <!-- ================================================= -->

    <model name="wall_D5_E5">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.0 0.10 0.50</size>
            </box>
