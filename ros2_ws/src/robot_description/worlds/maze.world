          </geometry>
        </visual>

      </link>

      <pose>2.5 4.0 0.25 0 0 0</pose>

    </model>



    <!-- ================================================= -->
    <!-- INNER WALL 4                                      -->
    <!-- ================================================= -->

    <model name="wall_B3_D3">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>2.0 0.10 0.50</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>2.0 0.10 0.50</size>
