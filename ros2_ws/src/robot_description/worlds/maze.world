          </geometry>
        </visual>

      </link>

      <pose>4.0 4.5 0.25 0 0 0</pose>

    </model>



    <!-- ================================================= -->
    <!-- INNER WALL 3                                      -->
    <!-- ================================================= -->

    <model name="wall_C2_D2">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.0 0.10 0.50</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.0 0.10 0.50</size>
