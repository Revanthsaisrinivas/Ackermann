      <pose>2.0 3.0 0.25 0 0 0</pose>

    </model>



    <!-- ================================================= -->
    <!-- INNER WALL 5                                      -->
    <!-- ================================================= -->

    <model name="wall_D3_D4">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.10 1.0 0.50</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.10 1.0 0.50</size>
            </box>
          </geometry>
        </visual>

      </link>

      <pose>3.0 2.5 0.25 0 0 0</pose>

    </model>



    <!-- ================================================= -->
    <!-- INNER WALL 6                                      -->
    <!-- ================================================= -->

    <model name="wall_E3_E5">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.10 2.0 0.50</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.10 2.0 0.50</size>
            </box>
          </geometry>
        </visual>

      </link>

      <pose>4.0 2.0 0.25 0 0 0</pose>

    </model>



    <!-- ================================================= -->
    <!-- INNER WALL 7                                      -->
    <!-- ================================================= -->

    <model name="wall_C4_D4">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.0 0.10 0.50</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.0 0.10 0.50</size>
            </box>
          </geometry>
        </visual>

      </link>

      <pose>2.5 2.0 0.25 0 0 0</pose>

    </model>



    <!-- ================================================= -->
    <!-- INNER WALL 8                                      -->
    <!-- ================================================= -->

    <model name="wall_A5_C5">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>2.0 0.10 0.50</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>2.0 0.10 0.50</size>
