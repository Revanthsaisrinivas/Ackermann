<?xml version="1.0"?>
<robot name="rl_robot"
       xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- =====================================================
       ROBOT GEOMETRY

       Hiwonder-style Ackermann chassis:
         - chassis: 270 x 120.5 x 50 mm model
         - wheel diameter: 60 mm
         - wheelbase: 0.18 m
         - track width: 0.17 m
         - front axle x = +0.09
         - rear axle x = -0.09
         - ground clearance ~ 0.02 m
  ===================================================== -->


  <!-- ===================================================== -->
  <!-- BASE FOOTPRINT                                        -->
  <!-- ===================================================== -->

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>

    <origin
      xyz="0 0 0.055"
      rpy="0 0 0"/>
  </joint>


  <!-- ===================================================== -->
  <!-- BASE LINK                                             -->
  <!-- ===================================================== -->

  <link name="base_link">

    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <geometry>
        <box size="0.270 0.1205 0.050"/>
      </geometry>

      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>


    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <geometry>
        <box size="0.270 0.1205 0.050"/>
      </geometry>
    </collision>


    <inertial>
      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <mass value="2.5"/>

      <inertia
        ixx="0.003546"
        ixy="0.0"
        ixz="0.0"
        iyy="0.015708"
        iyz="0.0"
        izz="0.018213"/>
    </inertial>

  </link>


  <!-- ===================================================== -->
  <!-- VIRTUAL STEERING LINK                                  -->
  <!-- Required by Ackermann plugin                           -->
  <!--                                                         -->
  <!--
       Tiny 1mm visual sphere added: this link (and the two
       front_*_steering_link links below) previously had ONLY
       inertial, no visual/collision at all, the suspected
       cause of the repeated Ogre AxisAlignedBox crash in
       gzclient ("min corner must be less than or equal to max
       corner"): a SceneNode with zero visual geometry can get
       a degenerate bounding box on some Gazebo/Ogre builds.
       No collision added, so this doesn't change physics or
       contact behavior at all.
  -->

  <link name="steering_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.001"/>
      </geometry>
      <material name="steering_marker">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <mass value="0.001"/>

      <inertia
        ixx="0.000001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.000001"
        iyz="0.0"
        izz="0.000001"/>
    </inertial>

  </link>


  <joint name="steering_joint" type="revolute">

    <parent link="base_link"/>
    <child link="steering_link"/>

    <origin
      xyz="0 0 0.05"
      rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <limit
      lower="-7.85"
      upper="7.85"
      effort="10"
      velocity="10"/>

  </joint>


  <!-- ===================================================== -->
  <!-- FRONT LEFT STEERING + WHEEL                            -->
  <!-- ===================================================== -->

  <link name="front_left_steering_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.001"/>
      </geometry>
      <material name="steering_marker">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <mass value="0.05"/>

      <inertia
        ixx="0.00001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00001"
        iyz="0.0"
        izz="0.00001"/>
    </inertial>

  </link>


  <joint
    name="front_left_steering_joint"
    type="revolute">

    <parent link="base_link"/>
    <child link="front_left_steering_link"/>

    <origin
      xyz="0.09 0.085 -0.03"
      rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <limit
      lower="-0.6"
      upper="0.6"
      effort="10"
      velocity="5"/>

    <dynamics
      damping="0.05"
      friction="0.05"/>

  </joint>


  <link name="front_left_wheel_link">

    <visual>
      <origin
        xyz="0 0 0"
        rpy="1.5708 0 0"/>

      <geometry>
        <cylinder
          radius="0.03"
          length="0.02"/>
      </geometry>

      <material name="black">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>


    <collision>
      <origin
        xyz="0 0 0"
        rpy="1.5708 0 0"/>

      <geometry>
        <cylinder
          radius="0.03"
          length="0.02"/>
      </geometry>
    </collision>


    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <mass value="0.15"/>

      <inertia
        ixx="0.0001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0001"
        iyz="0.0"
        izz="0.0001"/>
    </inertial>

  </link>


  <joint
    name="front_left_wheel_joint"
    type="continuous">

    <parent link="front_left_steering_link"/>
    <child link="front_left_wheel_link"/>

    <origin
      xyz="0 0 0"
      rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <dynamics
      damping="0.1"
      friction="0.1"/>

  </joint>


  <!-- ===================================================== -->
  <!-- FRONT RIGHT STEERING + WHEEL                           -->
  <!-- ===================================================== -->

  <link name="front_right_steering_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.001"/>
      </geometry>
      <material name="steering_marker">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <mass value="0.05"/>

      <inertia
        ixx="0.00001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00001"
        iyz="0.0"
        izz="0.00001"/>
    </inertial>

  </link>


  <joint
    name="front_right_steering_joint"
    type="revolute">

    <parent link="base_link"/>
    <child link="front_right_steering_link"/>

    <origin
      xyz="0.09 -0.085 -0.03"
      rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <limit
      lower="-0.6"
      upper="0.6"
      effort="10"
      velocity="5"/>

    <dynamics
      damping="0.05"
      friction="0.05"/>

  </joint>


  <link name="front_right_wheel_link">

    <visual>
      <origin
        xyz="0 0 0"
        rpy="1.5708 0 0"/>

      <geometry>
        <cylinder
          radius="0.03"
          length="0.02"/>
      </geometry>

      <material name="black">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>


    <collision>
      <origin
        xyz="0 0 0"
        rpy="1.5708 0 0"/>

      <geometry>
        <cylinder
          radius="0.03"
          length="0.02"/>
      </geometry>
    </collision>


    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <mass value="0.15"/>

      <inertia
        ixx="0.0001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0001"
        iyz="0.0"
        izz="0.0001"/>
    </inertial>

  </link>


  <joint
    name="front_right_wheel_joint"
    type="continuous">

    <parent link="front_right_steering_link"/>
    <child link="front_right_wheel_link"/>

    <origin
      xyz="0 0 0"
      rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <dynamics
      damping="0.0"
      friction="0.0"/>

  </joint>


  <!-- ===================================================== -->
  <!-- REAR LEFT WHEEL                                       -->
  <!-- ===================================================== -->

  <link name="rear_left_wheel_link">

    <visual>
      <origin
        xyz="0 0 0"
        rpy="1.5708 0 0"/>

      <geometry>
        <cylinder
          radius="0.03"
          length="0.02"/>
      </geometry>

      <material name="black">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>


    <collision>
      <origin
        xyz="0 0 0"
        rpy="1.5708 0 0"/>

      <geometry>
        <cylinder
          radius="0.03"
          length="0.02"/>
      </geometry>
    </collision>


    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <mass value="0.15"/>

      <inertia
        ixx="0.0001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0001"
        iyz="0.0"
        izz="0.0001"/>
    </inertial>

  </link>


  <joint
    name="rear_left_wheel_joint"
    type="continuous">

    <parent link="base_link"/>
    <child link="rear_left_wheel_link"/>

    <origin
      xyz="-0.09 0.085 -0.02"
      rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <dynamics
      damping="0.1"
      friction="0.1"/>

  </joint>


  <!-- ===================================================== -->
  <!-- REAR RIGHT WHEEL                                      -->
  <!-- ===================================================== -->

  <link name="rear_right_wheel_link">

    <visual>
      <origin
        xyz="0 0 0"
        rpy="1.5708 0 0"/>

      <geometry>
        <cylinder
          radius="0.03"
          length="0.02"/>
      </geometry>

      <material name="black">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>


    <collision>
      <origin
        xyz="0 0 0"
        rpy="1.5708 0 0"/>

      <geometry>
        <cylinder
          radius="0.03"
          length="0.02"/>
      </geometry>
    </collision>


    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <mass value="0.15"/>

      <inertia
        ixx="0.0001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0001"
        iyz="0.0"
        izz="0.0001"/>
    </inertial>

  </link>


  <joint
    name="rear_right_wheel_joint"
    type="continuous">

    <parent link="base_link"/>
    <child link="rear_right_wheel_link"/>

    <origin
      xyz="-0.09 -0.085 -0.02"
      rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <dynamics
      damping="0.0"
      friction="0.0"/>

  </joint>


  <!-- ===================================================== -->
  <!-- LIDAR LINK                                             -->
  <!-- ===================================================== -->

  <link name="lidar_link">

    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <geometry>
        <cylinder
          radius="0.04"
          length="0.03"/>
      </geometry>

      <material name="lidar_black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>


    <inertial>
      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <mass value="0.05"/>

      <inertia
        ixx="0.0001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0001"
        iyz="0.0"
        izz="0.0001"/>
    </inertial>

  </link>


  <joint name="lidar_joint" type="fixed">

    <parent link="base_link"/>
    <child link="lidar_link"/>

    <origin
      xyz="0 0 0.05"
      rpy="0 0 0"/>

  </joint>


  <!-- ===================================================== -->
  <!-- LIDAR GAZEBO SENSOR                                   -->
  <!-- ===================================================== -->

  <gazebo reference="lidar_link">

    <sensor
      name="lidar_sensor"
      type="ray">

      <pose>
        0 0 0 0 0 0
      </pose>

      <!-- Prevent Gazebo Classic Ogre ray-visualization crash -->
      <visualize>false</visualize>

      <update_rate>10</update_rate>

      <always_on>true</always_on>

      <ray>

        <scan>

          <horizontal>

            <samples>360</samples>

            <resolution>1</resolution>

            <!-- Avoid exactly coincident -pi/+pi rays -->
            <min_angle>-3.13</min_angle>
            <max_angle>3.13</max_angle>

          </horizontal>

        </scan>


        <range>

          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>

        </range>

      </ray>


      <plugin
        name="gazebo_ros_lidar"
        filename="libgazebo_ros_ray_sensor.so">

        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>

        <output_type>
          sensor_msgs/LaserScan
        </output_type>

        <frame_name>
          lidar_link
        </frame_name>

      </plugin>

    </sensor>

  </gazebo>


  <!-- ===================================================== -->
  <!-- GAZEBO MATERIALS / FRICTION                           -->
  <!-- ===================================================== -->

  <gazebo reference="base_link">
    <material>
      Gazebo/Blue
    </material>
  </gazebo>


  <gazebo reference="front_left_wheel_link">

    <material>
      Gazebo/Black
    </material>

    <mu1>1.0</mu1>
    <mu2>1.0</mu2>

    <kp>1000000.0</kp>
    <kd>1.0</kd>

  </gazebo>


  <gazebo reference="front_right_wheel_link">

    <material>
      Gazebo/Black
    </material>

    <mu1>1.0</mu1>
    <mu2>1.0</mu2>

    <kp>1000000.0</kp>
    <kd>1.0</kd>

  </gazebo>


  <gazebo reference="rear_left_wheel_link">

    <material>
      Gazebo/Black
    </material>

    <mu1>1.0</mu1>
    <mu2>1.0</mu2>

    <kp>1000000.0</kp>
    <kd>1.0</kd>

  </gazebo>


  <gazebo reference="rear_right_wheel_link">

    <material>
      Gazebo/Black
    </material>

    <mu1>1.0</mu1>
    <mu2>1.0</mu2>

    <kp>1000000.0</kp>
    <kd>1.0</kd>

  </gazebo>


  <!-- ===================================================== -->
  <!-- ACKERMANN DRIVE PLUGIN                                -->
  <!-- ===================================================== -->

  <gazebo>

    <plugin
      name="ackermann_drive"
      filename="libgazebo_ros_ackermann_drive.so">

      <ros>
        <namespace>/</namespace>
      </ros>

      <update_rate>
        50.0
      </update_rate>


      <front_left_joint>
        front_left_wheel_joint
      </front_left_joint>

      <front_right_joint>
        front_right_wheel_joint
      </front_right_joint>

      <rear_left_joint>
        rear_left_wheel_joint
      </rear_left_joint>

      <rear_right_joint>
        rear_right_wheel_joint
      </rear_right_joint>


      <left_steering_joint>
        front_left_steering_joint
      </left_steering_joint>

      <right_steering_joint>
        front_right_steering_joint
      </right_steering_joint>


      <steering_wheel_joint>
        steering_joint
      </steering_wheel_joint>


      <wheel_separation>
        0.17
      </wheel_separation>

      <wheel_diameter>
        0.06
      </wheel_diameter>

      <wheel_base>
        0.18
      </wheel_base>


      <max_steer>
        0.6
      </max_steer>

      <max_steering_angle>
        7.85
      </max_steering_angle>

      <max_speed>
        2.0
      </max_speed>


      <left_steering_pid_gain>
        1500 0 1
      </left_steering_pid_gain>

      <left_steering_i_range>
        0 0
      </left_steering_i_range>


      <right_steering_pid_gain>
        1500 0 1
      </right_steering_pid_gain>

      <right_steering_i_range>
        0 0
      </right_steering_i_range>


      <linear_velocity_pid_gain>
        1000 0 1
      </linear_velocity_pid_gain>

      <linear_velocity_i_range>
        0 0
      </linear_velocity_i_range>


      <odometry_topic>
        odom
      </odometry_topic>

      <odometry_frame>
        odom
      </odometry_frame>

      <robot_base_frame>
        base_footprint
      </robot_base_frame>


      <publish_odom>
        true
      </publish_odom>

      <publish_odom_tf>
        true
      </publish_odom_tf>

      <publish_wheel_tf>
        true
      </publish_wheel_tf>

    </plugin>

  </gazebo>

</robot>
