<?xml version="1.0"?>

<robot name="rl_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================= BASE ================= -->

  <link name="base_link">

    <visual>
      <geometry>
        <box size="0.40 0.30 0.15"/>
      </geometry>

      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="0.40 0.30 0.15"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="5.0"/>

      <inertia
        ixx="0.05"
        ixy="0.0"
        ixz="0.0"
        iyy="0.08"
        iyz="0.0"
        izz="0.10"/>
    </inertial>

  </link>

  <!-- ================= LIDAR ================= -->

  <link name="lidar_link">

    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.03"/>
      </geometry>

      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>

  </link>

  <joint name="lidar_joint" type="fixed">

    <parent link="base_link"/>
    <child link="lidar_link"/>

    <origin xyz="0 0 0.10" rpy="0 0 0"/>

  </joint>

</robot>