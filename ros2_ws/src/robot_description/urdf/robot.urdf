<?xml version="1.0"?>

<robot name="rl_robot">

  <link name="base_link">

    <visual>
      <geometry>
        <box size="0.4 0.3 0.15"/>
      </geometry>

      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="0.4 0.3 0.15"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="5"/>

      <inertia
        ixx="0.1"
        ixy="0"
        ixz="0"
        iyy="0.1"
        iyz="0"
        izz="0.1"/>
    </inertial>

  </link>

</robot>