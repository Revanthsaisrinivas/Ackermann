<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>robot_controller</name>
  <version>0.0.0</version>

  <description>Robot controller package</description>

  <maintainer email="revanth@todo.todo">revanth</maintainer>

  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <!-- SAC policy. Installed in the project venv
       (.venv-drl); rosdep has no key for the CPU
       wheel index, so this is declarative only. -->
  <exec_depend>python3-torch</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>